# --- Telegram (token from @BotFather; your numeric user ID: leave ALLOWED_USER_IDS empty, message the bot, it replies with your ID) ---
TELEGRAM_TOKEN=
ALLOWED_USER_IDS=
TZ=UTC

# --- HTTP API (OpenAI-compatible; lets any frontend use this as a "model"). Empty API_ADDR = disabled ---
# Telegram becomes optional if API_ADDR is set. Set a long random API_KEY (e.g. `openssl rand -hex 24`).
API_ADDR=
API_KEY=
API_MODEL_NAME=companion

# --- Chat model: any OpenAI-compatible server (DeepSeek API / llama.cpp / vLLM / ...). Base URL WITHOUT /chat/completions ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek V4 thinks by default (slower, extra output tokens). Turn it off for chat:
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Local Qwen via llama.cpp, for example:
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=qwen
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Background memory work (extraction / summaries / consolidation). Defaults to the chat model; a cheaper one is fine ---
# MAINT_BASE_URL=
# MAINT_API_KEY=
# MAINT_MODEL=

# --- Image reading: needs a vision-capable model (defaults to the chat endpoint) ---
# deepseek-flash accepts images; deepseek-v4-pro does NOT. Leave VISION_* unset to reuse the chat endpoint.
VISION_ENABLED=true
# VISION_BASE_URL=
# VISION_MODEL=

# --- Embeddings (required; independent of the chat model) ---
EMBED_BASE_URL=http://host.docker.internal:8081/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
AUTO_REEMBED=true

# --- Web search for the model (DeepSeek Search/Fetch API, ~5元/1000 requests; queries/URLs are sent to that service) ---
SEARCH_ENABLED=false
# SEARCH_BASE_URL=     # default: LLM_BASE_URL
# SEARCH_API_KEY=      # default: LLM_API_KEY
# MAX_TOOL_ROUNDS=4

# --- Optional: prices (USD per million tokens, official table, OFF-PEAK rates) so /status can show an estimated cost.
# /status does not distinguish peak hours (peak is 2x), so treat it as a lower bound. deepseek-v4-pro:
# PRICE_CACHE_HIT=0.022
# PRICE_CACHE_MISS=0.66
# PRICE_OUTPUT=1.98
# PRICE_CURRENCY=USD
# deepseek-flash: 0.003 / 0.15 / 0.6

# --- Tuning ---
# TEMPERATURE=0.8
# RECENT_TOKENS=3000
# MEMORY_TOKENS=1200
# TOP_K=8
# MIN_SIM=0.35
# EXTRACT_EVERY=3
# IDLE_MINUTES=20
# CONSOLIDATE_HOURS=20
# CORE_MAX_CHARS=600
# MAX_PINS=5
