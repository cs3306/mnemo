diff --git a/internal/bot/trigger.go b/internal/bot/trigger.go
new file mode 100644
index 0000000..577d6c1
--- /dev/null
+++ b/internal/bot/trigger.go
@@ -0,0 +1,82 @@
+package bot
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"strings"
+	"time"
+)
+
+const (
+	triggerMaxPrompt = 4000
+	triggerMaxLabel  = 60
+	triggerTimeout   = 10 * time.Minute
+)
+
+// apiTrigger starts a turn in the Telegram conversation on behalf of something other than the user (a scheduler plugin,
+// cron, a script): POST /v1/trigger {"prompt": "...", "label": "晨报", "chat": 123}. "chat" defaults to the first
+// allowed user. It answers 202 at once; the reply (and any files tools produced) goes to Telegram when ready.
+func (a *App) apiTrigger(w http.ResponseWriter, r *http.Request) {
+	if a.tg == nil {
+		apiError(w, 409, "no Telegram bot is configured, so there is nowhere to send the result")
+		return
+	}
+	var req struct {
+		Prompt string `json:"prompt"`
+		Label  string `json:"label"`
+		Chat   *int64 `json:"chat"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&req); err != nil {
+		apiError(w, 400, "body must be {\"prompt\": \"...\", \"label\": \"...\"}")
+		return
+	}
+	req.Prompt, req.Label = strings.TrimSpace(req.Prompt), strings.TrimSpace(req.Label)
+	switch {
+	case req.Prompt == "":
+		apiError(w, 400, "prompt is empty")
+		return
+	case len([]rune(req.Prompt)) > triggerMaxPrompt:
+		apiError(w, 400, fmt.Sprintf("prompt is longer than %d characters", triggerMaxPrompt))
+		return
+	}
+	chat := a.defaultChat()
+	if req.Chat != nil {
+		chat = *req.Chat
+	}
+	if !a.cfg.AllowedIDs[chat] {
+		apiError(w, 403, "chat is not an allowed Telegram user")
+		return
+	}
+	if req.Label == "" {
+		req.Label = "定时任务"
+	}
+	label := truncate(strings.ReplaceAll(req.Label, "\n", " "), triggerMaxLabel)
+	a.goBG(func() { a.runScheduled(chat, label, req.Prompt) })
+	w.WriteHeader(http.StatusAccepted)
+	writeJSON(w, map[string]string{"status": "accepted"})
+}
+
+// runScheduled runs one scheduled turn like a normal one (persona, memory, tools, plugins) and sends the result.
+func (a *App) runScheduled(chat int64, label, prompt string) {
+	l := a.chatLock(chat)
+	l.Lock()
+	defer l.Unlock()
+	a.touch(chat)
+	defer a.touch(chat)
+	ctx, cancel := context.WithTimeout(a.bg, triggerTimeout)
+	defer cancel()
+	a.tg.Typing(ctx, chat)
+	instruction := fmt.Sprintf("[定时任务「%s」到点了。这是用户事先设好的任务，不是用户刚刚发来的消息。请直接完成它，像平时聊天一样把结果发给用户；"+
+		"不要说“收到任务”之类的话，也不要把这段说明复述出来。]\n%s", label, prompt)
+	r, err := a.RespondTools(ctx, chat, "", nil, TurnOpts{Instruction: instruction, Deliver: a.canSendFiles()})
+	if err != nil {
+		slog.Warn("scheduled turn failed", "label", label, "err", err)
+		a.send(ctx, chat, fmt.Sprintf("定时任务「%s」没有成功：%s", label, truncate(err.Error(), 200)))
+		return
+	}
+	a.send(ctx, chat, r.Text)
+	a.deliverFiles(ctx, chat, r.Files)
+}
diff --git a/internal/bot/trigger_test.go b/internal/bot/trigger_test.go
new file mode 100644
index 0000000..d0e2c2c
--- /dev/null
+++ b/internal/bot/trigger_test.go
@@ -0,0 +1,81 @@
+package bot
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func triggerPost(t *testing.T, srv *httptest.Server, key, body string) *http.Response {
+	t.Helper()
+	req, _ := http.NewRequest("POST", srv.URL+"/v1/trigger", strings.NewReader(body))
+	if key != "" {
+		req.Header.Set("Authorization", "Bearer "+key)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { resp.Body.Close() })
+	return resp
+}
+
+func TestTriggerRunsScheduledTurnAndStoresOnlyReply(t *testing.T) {
+	srv, app, chat := apiApp(t)
+	tg := app.tg.(*fakeTG)
+	chat.Replies = []string{"早安！今天有三件事。"}
+	if r := triggerPost(t, srv, "secret", `{"prompt":"查今天的新闻，给我晨报","label":"晨报"}`); r.StatusCode != 202 {
+		t.Fatalf("status %d", r.StatusCode)
+	}
+	app.Wait()
+	if got := tg.last(); got != "早安！今天有三件事。" {
+		t.Fatalf("telegram got %q", got)
+	}
+	if len(chat.Calls) == 0 {
+		t.Fatal("model not called")
+	}
+	var prompt string
+	for _, m := range chat.Calls[0] {
+		prompt += fmt.Sprint(m.Content) + "\n"
+	}
+	if !strings.Contains(prompt, "定时任务「晨报」") || !strings.Contains(prompt, "查今天的新闻，给我晨报") {
+		t.Fatalf("instruction missing from prompt:\n%s", prompt)
+	}
+	var user, assistant int
+	for _, m := range app.st.MessagesAfter(42, 0, 100) {
+		switch m.Role {
+		case "user":
+			user++
+		case "assistant":
+			assistant++
+		}
+	}
+	if user != 0 || assistant != 1 {
+		t.Fatalf("stored user=%d assistant=%d, want 0/1", user, assistant)
+	}
+}
+
+func TestTriggerValidation(t *testing.T) {
+	srv, _, chat := apiApp(t)
+	cases := []struct {
+		key, body string
+		want      int
+	}{
+		{"", `{"prompt":"x"}`, 401},
+		{"bad", `{"prompt":"x"}`, 401},
+		{"secret", `not json`, 400},
+		{"secret", `{"prompt":"  "}`, 400},
+		{"secret", `{"prompt":"` + strings.Repeat("字", triggerMaxPrompt+1) + `"}`, 400},
+		{"secret", `{"prompt":"x","chat":7}`, 403},
+	}
+	for _, c := range cases {
+		if r := triggerPost(t, srv, c.key, c.body); r.StatusCode != c.want {
+			t.Errorf("%q -> %d, want %d", c.body[:min(len(c.body), 30)], r.StatusCode, c.want)
+		}
+	}
+	if len(chat.Calls) != 0 {
+		t.Fatal("rejected requests must not reach the model")
+	}
+}
