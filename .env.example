# --- Telegram (token from @BotFather; your numeric user ID: leave ALLOWED_USER_IDS empty, message the bot, it replies with your ID) ---
TELEGRAM_TOKEN=
ALLOWED_USER_IDS=
TZ=UTC
# Send the model's replies as Telegram rich messages (Bot API 10.1+: tables, headings, LaTeX formulas). Default on;
# if the server rejects one it falls back to plain text. Set 0 to always send plain text.
# TELEGRAM_RICH=1
# Directory for the user-editable persona.md / profile.md (default: DATA_DIR). Set it to a read-only host mount to edit them without entering the container.
# CONFIG_DIR=/config

# --- HTTP API (OpenAI-compatible; lets any frontend use this as a "model"). Empty API_ADDR = disabled ---
# Telegram becomes optional if API_ADDR is set. Set a long random API_KEY (e.g. `openssl rand -hex 24`).
API_ADDR=
API_KEY=
API_MODEL_NAME=companion

# --- Chat model: any OpenAI-compatible server (DeepSeek API / llama.cpp / vLLM / ...). Base URL WITHOUT /chat/completions ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek V4 thinks by default (slower, extra output tokens). Turn it off for chat:
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Local Qwen via llama.cpp, for example:
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=qwen
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Background memory work (extraction / summaries / consolidation). Defaults to the chat model; a cheaper one is fine ---
# MAINT_BASE_URL=
# MAINT_API_KEY=
# MAINT_MODEL=

# --- Style review (/style): a stronger model reads recent chats and proposes edits to the style notes ---
# Defaults to the MAINT_* endpoint (which defaults to LLM_*). Proposals wait for /style approve unless
# REVIEW_AUTO_APPLY=true. If MAINT_MODEL is a cheap model, the reviewer can use the stronger chat model:
# REVIEW_MODEL=deepseek-v4-pro
# Any OpenAI-compatible provider works, e.g. Claude: REVIEW_BASE_URL=https://api.anthropic.com/v1 + REVIEW_API_KEY
# REVIEW_HOURS=24            # at most one automatic review per N hours; 0 = only /style review
# REVIEW_MIN_MESSAGES=20     # new messages needed before an automatic review
# REVIEW_MAX_CHARS=30000     # conversation text sent per review (newest kept)
# REVIEW_AUTO_APPLY=false
# STYLE_MAX_CHARS=800

# --- Image reading: needs a vision-capable model ---
# deepseek-flash accepts images; deepseek-v4-pro does NOT, and may silently ignore the image and invent a
# transcription. VISION_BASE_URL / VISION_API_KEY default to the chat endpoint's; always set VISION_MODEL
# explicitly when the chat model is deepseek-v4-pro. At startup the bot renders a random 4-digit image and
# checks that the vision model reads it back (VISION_PROBE=false disables this; /visiontest re-runs it).
VISION_ENABLED=true
VISION_MODEL=deepseek-flash
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_PROBE=true

# --- Embeddings (required; independent of the chat model) ---
EMBED_BASE_URL=http://host.docker.internal:8081/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
AUTO_REEMBED=true

# --- Web search for the model (DeepSeek Search/Fetch API, ~5元/1000 requests; queries/URLs are sent to that service) ---
SEARCH_ENABLED=false
# SEARCH_PROVIDER=deepseek   # deepseek | searxng (self-hosted; no third-party API, no per-call fee)
# SEARXNG_URL=http://searxng:8080   # required for searxng; the instance must enable the json format
# FETCH_ALLOW_PRIVATE=false  # searxng mode: web_fetch refuses loopback/private/link-local addresses unless true
# SEARCH_BASE_URL=     # default: LLM_BASE_URL
# SEARCH_API_KEY=      # default: LLM_API_KEY
# MAX_TOOL_ROUNDS=4       # tool rounds per turn; after that no tools are offered and the model must report where it got to
# TOOL_GRACE_ROUNDS=3     # for the last N rounds the model is told how many calls it has left, so it can wrap up (0 = never tell)

# --- Optional: prices (USD per million tokens, official table, OFF-PEAK rates) so /status can show an estimated cost.
# /status does not distinguish peak hours (peak is 2x), so treat it as a lower bound. deepseek-v4-pro:
# PRICE_CACHE_HIT=0.022
# PRICE_CACHE_MISS=0.66
# PRICE_OUTPUT=1.98
# PRICE_CURRENCY=USD
# deepseek-flash: 0.003 / 0.15 / 0.6

# --- Tuning ---
# TEMPERATURE=0.8
# RECENT_TOKENS=3000
# MEMORY_TOKENS=1200
# TOP_K=8
# MIN_SIM=0.35
# EXTRACT_EVERY=3
# IDLE_MINUTES=20
# CONSOLIDATE_HOURS=20
# CORE_MAX_CHARS=600
# MAX_PINS=5

# --- Tool plugins (documents, spreadsheets, images, ...): see README "Plugins" and github.com/cs3306/mnemo-plugin ---
# PLUGIN_URLS=http://mnemo-plugin:8090    # comma-separated base URLs of plugin servers
# PLUGIN_TOKEN=                           # shared bearer token (same value as the plugin server's PLUGIN_TOKEN)
# PLUGIN_TIMEOUT=180                      # seconds per tool call
# PLUGIN_EVENTS=                          # events plugins may be told about (POST /v1/events): empty = none (default), true = all,
#                                         # or a list: user_message,turn_done,startup. A plugin also has to ask for them itself.

# --- Voice: speech to text (incoming voice notes) and text to speech (spoken replies) ---
# Any OpenAI-compatible server with /audio/transcriptions and /audio/speech works. The STT server must accept
# Telegram's .ogg/Opus files (speaches / faster-whisper-server do; whisper.cpp needs --convert and ffmpeg).
# STT_ENABLED=false
# STT_BASE_URL=http://192.168.0.231:41210/v1
# STT_MODEL=large-v3-turbo
# STT_API_KEY=
# STT_LANGUAGE=zh              # empty = auto-detect
# STT_TIMEOUT=120
# TTS_ENABLED=false
# TTS_BASE_URL=http://192.168.0.231:41211/v1
# TTS_MODEL=kokoro
# TTS_VOICE=zf_xiaobei         # server-specific voice name (default, also used for auto read-aloud)
# TTS_VOICES=mll=软萌日常;serena=更俏皮夸张   # voices she may choose between in send_voice: name=when to use; ...
# TTS_FORMAT=mp3               # mp3 | opus (what Telegram voice messages accept)
# TTS_MODE=auto                # auto = voice reply only to voice notes; always; off; weighted = random, see below. /voice changes it at runtime
# TTS_VOICE_WEIGHT=0.3         # weighted mode: chance (0..1) of a voice reply to typed text
# TTS_VOICE_WEIGHT_IN=0.9      # weighted mode: chance (0..1) of a voice reply to a voice note
# TTS_VOICE_ADAPT=true         # weighted mode: odds also move with reply length, warm/technical wording, mood and recent streak; false = plain weights
# TTS_MAX_CHARS=500            # longer replies stay text-only (code, long explanations)
# TTS_TEXT=true                # also send the text of a spoken reply
# TTS_EXTRA_BODY={"speed":1.0} # extra JSON fields for /audio/speech
